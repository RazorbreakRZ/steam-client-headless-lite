<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal Openbox config for the single-app Steam kiosk session.
  Goal: whatever window Steam opens should be focused and maximised so it fills
  the noVNC viewport, instead of appearing minimised / unplaced (which looks
  like a black screen). We keep everything else at Openbox defaults.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>

  <applications>
    <!-- The modern Steam client renders its ENTIRE UI through steamwebhelper
         (a CEF/Chromium process). That window carries class "steamwebhelper" /
         "Steamwebhelper" — NOT "Steam" — and Steam opens it tiny (e.g. 200x200)
         in the top-left corner, leaving the rest of the framebuffer black.
         Force it fullscreen so it fills the noVNC viewport. -->
    <application class="steamwebhelper">
      <focus>yes</focus>
      <maximized>yes</maximized>
      <decor>no</decor>
    </application>
    <application class="Steamwebhelper">
      <focus>yes</focus>
      <maximized>yes</maximized>
      <decor>no</decor>
    </application>
    <!-- The main Steam window (older/other dialogs). -->
    <application class="Steam">
      <focus>yes</focus>
      <maximized>yes</maximized>
      <decor>no</decor>
    </application>
    <application class="steam">
      <focus>yes</focus>
      <maximized>yes</maximized>
      <decor>no</decor>
    </application>
  </applications>
</openbox_config>
